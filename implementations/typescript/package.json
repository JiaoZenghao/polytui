{
  "name": "@polytui/typescript",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "bin": {
    "polytui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
